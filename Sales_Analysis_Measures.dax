// =========================================================================
// POWER BI DAX MEASURES LIBRARY - SALES ANALYSIS REPORT 2020
// Paste these measures directly into your Power BI Data Model
// =========================================================================

// -------------------------------------------------------------------------
// 1. CORE KPI MEASURES (Displayed in the 5 Left Sidebar Cards)
// -------------------------------------------------------------------------

// 1.1 Total Customers
Total Customers = 
DISTINCTCOUNT('Sales_Analysis_2020'[Customer Name])

// 1.2 Total Orders
Total Orders = 
DISTINCTCOUNT('Sales_Analysis_2020'[Order ID])

// 1.3 Total Quantity
Total Quantity = 
SUM('Sales_Analysis_2020'[Quantity])

// 1.4 Total Sales
Total Sales = 
SUM('Sales_Analysis_2020'[Sales])

// 1.5 Total Profit
Total Profit = 
SUM('Sales_Analysis_2020'[Profit])


// -------------------------------------------------------------------------
// 2. PROFITABILITY & MARGIN RATIOS
// -------------------------------------------------------------------------

// 2.1 Overall Profit Margin %
Profit Margin % = 
DIVIDE([Total Profit], [Total Sales], 0)

// 2.2 Average Order Value (AOV)
Average Order Value = 
DIVIDE([Total Sales], [Total Orders], 0)

// 2.3 Average Sales Per Customer
Sales Per Customer = 
DIVIDE([Total Sales], [Total Customers], 0)


// -------------------------------------------------------------------------
// 3. SEGMENT & BREAKDOWN MEASURES (For Donut & Slicer Charts)
// -------------------------------------------------------------------------

// 3.1 Segment Sales Share % (Used in Center Donut Chart)
Segment Sales % = 
DIVIDE(
    [Total Sales], 
    CALCULATE([Total Sales], ALL('Sales_Analysis_2020'[Segment])), 
    0
)

// 3.2 Segment Profit Share % (Used in Bottom-Right Donut Chart)
Segment Profit % = 
DIVIDE(
    [Total Profit], 
    CALCULATE([Total Profit], ALL('Sales_Analysis_2020'[Segment])), 
    0
)


// -------------------------------------------------------------------------
// 4. TOP N FILTERING & RANKINGS (For Bar Charts)
// -------------------------------------------------------------------------

// 4.1 Product Rank by Sales
Product Sales Rank = 
RANKX(
    ALL('Sales_Analysis_2020'[Product Name]), 
    [Total Sales], 
    , 
    DESC, 
    Dense
)

// 4.2 Customer Rank by Sales
Customer Sales Rank = 
RANKX(
    ALL('Sales_Analysis_2020'[Customer Name]), 
    [Total Sales], 
    , 
    DESC, 
    Dense
)

// 4.3 Top 5 Products Flag (Filter measure: Set visual filter to is 1)
Top 5 Product Filter = 
IF([Product Sales Rank] <= 5, 1, 0)

// 4.4 Top 5 Customers Flag (Filter measure: Set visual filter to is 1)
Top 5 Customer Filter = 
IF([Customer Sales Rank] <= 5, 1, 0)


// -------------------------------------------------------------------------
// 5. FORMATTED DISPLAY STRINGS (Optional Custom Tooltips / Cards)
// -------------------------------------------------------------------------

Formatted Sales = 
SWITCH(
    TRUE(),
    [Total Sales] >= 1000000, FORMAT([Total Sales] / 1000000, "$0.00") & "M",
    [Total Sales] >= 1000, FORMAT([Total Sales] / 1000, "$0.0") & "K",
    FORMAT([Total Sales], "$#,##0")
)

Formatted Profit = 
SWITCH(
    TRUE(),
    [Total Profit] >= 1000000, FORMAT([Total Profit] / 1000000, "$0.00") & "M",
    [Total Profit] >= 1000, FORMAT([Total Profit] / 1000, "$0.0") & "K",
    FORMAT([Total Profit], "$#,##0")
)

Formatted Quantity = 
SWITCH(
    TRUE(),
    [Total Quantity] >= 1000, FORMAT([Total Quantity] / 1000, "0") & "K",
    FORMAT([Total Quantity], "#,##0")
)
